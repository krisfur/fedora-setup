#!/bin/bash
# Prefer 6 GHz wherever it exists as its own SSID.
#
# NM has no band preference to set: 802-11-wireless.band only takes "a"/"bg"
# (no 6 GHz value) and locks a profile to one band rather than ranking them,
# and NetworkManager.conf has no global equivalent. When an AP puts 6 GHz on a
# separate SSID, preferring the band means preferring that profile, so: any
# saved profile currently on air above 5900 MHz gets autoconnect-priority 10,
# which outranks everything left at the default 0. No SSID is named, so this
# follows to any network. It only ever raises a priority, never lowers one.
#
# It also runs on resume because ath11k re-inits its firmware there and the
# 6 GHz half of the channel list only returns with the regulatory push,
# measured at 0-24s after resume (median 5s, p90 20s). NM's own post-resume
# scan often starts before that and settles on 2.4/5 GHz until the next
# periodic scan up to two minutes on. Wait on the channel list itself: nmcli's
# BSS list still holds pre-suspend 6 GHz entries.
set -e

seen=$(mktemp)
trap 'rm -f "$seen"' EXIT

# Until the regulatory push every 6 GHz channel is disabled.
for i in $(seq 40); do
  if iw phy | grep -E '\* 6[0-9]{3}\.0 MHz' | grep -qv disabled; then break; fi
  sleep 1
done

# Retry: on resume the first scans run before the band is back.
for i in 1 2 3 4 5 6; do
  if nmcli device wifi rescan >/dev/null 2>&1; then
    sleep 3
    # FREQ first so the frequency is the field that cannot contain a colon;
    # nmcli escapes colons inside the SSID, hence the gsub.
    nmcli -t -f FREQ,SSID device wifi list \
      | awk -F: '$1 + 0 > 5900 { sub(/^[^:]*:/, ""); gsub(/\\:/, ":"); if (length($0)) print }' \
      | sort -u > "$seen"
    if [ -s "$seen" ]; then break; fi
  fi
  sleep 5
done

nmcli -t -f UUID,TYPE connection show \
  | awk -F: '$2 == "802-11-wireless" { print $1 }' \
  | while read -r uuid; do
      ssid=$(nmcli -g 802-11-wireless.ssid connection show "$uuid") || continue
      grep -qxF "$ssid" "$seen" || continue
      prio=$(nmcli -g connection.autoconnect-priority connection show "$uuid")
      if [ "$prio" -lt 10 ] 2>/dev/null; then
        nmcli connection modify "$uuid" connection.autoconnect-priority 10
      fi
    done
